# Compose environment for the Ritme BETA stack (https://beta.ritme.app, REAL users).
# Lives at /opt/ritme-beta/.env on the server. Server-only: deploy-beta.sh excludes it from rsync.
# On the very first deploy deploy-beta.sh generates it (fresh secrets; SMS keys copied from staging's .env) and
# writes the admin login to /root/ritme-beta-credentials.txt — so this file is documentation, not a template you
# must fill by hand. Never reuse production's or staging's secrets here.
#
# APP_ENV / APP_DEBUG are forced by docker-compose.beta.yml (production / false).

APP_KEY=base64:GENERATED
APP_URL=https://beta.ritme.app

DB_DATABASE=ritme_beta
DB_USERNAME=ritme_beta
DB_PASSWORD=GENERATED
DB_ROOT_PASSWORD=GENERATED

# Same origin as the frontend; baked into the browser bundle at build time.
NEXT_PUBLIC_API_BASE_URL=https://beta.ritme.app/api/v1
SITE_URL=https://beta.ritme.app

ADMIN_SEED_EMAIL=admin@ritme.app
ADMIN_SEED_PASSWORD=GENERATED

# Real OTP SMS — every login costs real credit.
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_TEMPLATE_LOGIN_OTP=1507703
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=511293
SMSIR_LINE_NUMBER=

SWAGGER_USER=ritme
SWAGGER_PASSWORD=GENERATED

# Providers. Empty = `none` under APP_ENV=production (the feature answers 503); `fake` is refused at start-up.
PAYMENT_PROVIDER=
ZARINPAL_MERCHANT_ID=
# Android store in-app billing (android-shell store builds). The RSA keys are PUBLIC (from each store's developer
# panel), not secrets. Empty key = that store is off (store verify answers 503).
BAZAAR_PACKAGE_NAME=web.ritme.app
BAZAAR_RSA_PUBLIC_KEY=MIHNMA0GCSqGSIb3DQEBAQUAA4G7ADCBtwKBrwDiBhR4d7x9iA/9LtGE+p5fJBbI9zFYzhGCW19YutmZPVl85RmAhsXp6DSaWYyFHngXu03UFHx7Pv2r9ErwDlNv+Ea5oNoEF1r0P5Wg07Q3nNJFosajKYto+Ch5z3Zx9cpNLTSgFqHfmFN8y0kJA0LTrz5cWTRlFHejO0mkjjPUjmCPmynxj6BndhmQ4qvOUijvlRAZ88t+H7Dzt8NGfjIOg/nvQkVH2a9viFORQCkCAwEAAQ==
MYKET_PACKAGE_NAME=web.ritme.app
MYKET_RSA_PUBLIC_KEY=
AI_PROVIDER=
GEMINI_API_KEY=
ARVAN_AI_BASE_URL=
ARVAN_AI_API_KEY=
COMPANION_SMS_PROVIDER=

# Secrets (generated: openssl rand -base64 48 for peppers, -base64 32 for keys). Rotating a key: move the old value
# to the matching *_PREVIOUS (comma-separated) first, or existing encrypted data becomes unreadable.
COMPANION_CODE_PEPPER=GENERATED
SHARE_CODE_PEPPER=GENERATED
PRIVATE_NOTE_KEY=GENERATED
LAB_FILE_KEY=GENERATED
FILE_KEY=GENERATED
MEDIA_URL_KEY=GENERATED

# Web Push for medication reminders (backend-go internal/care). Generate once per environment on the server:
#   docker compose exec backend-go /app/api vapid-keys
# The private key is a secret. Changing the pair invalidates every stored browser subscription. Empty = web push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@ritme.app

# «یادآور پیامکی» for Ritme Plus (medication doses + doctor appointments by SMS). none | fake | gateway.
# gateway needs three Kavenegar verify/lookup templates (names below):
#   med-reminder:          «ریتمی: وقت %token10 است (ساعت %token).»
#   appointment-reminder:  «ریتمی: یادآور %token10، %token20.»
#   neutral (required for users with «متن خنثی» on, the default): «ریتمی: برای ساعت %token یک یادآور داری.»
REMINDER_SMS_PROVIDER=none
KAVENEGAR_TEMPLATE_MED_REMINDER=med-reminder
KAVENEGAR_TEMPLATE_APPOINTMENT_REMINDER=appointment-reminder
KAVENEGAR_TEMPLATE_REMINDER_NEUTRAL=
REMINDER_SMS_DAILY_CAP=8
