# Docker Compose environment for the Ritme stack. Copy to .env and fill in.
APP_KEY=base64:GENERATE_WITH_openssl_rand_-base64_32
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_DATABASE=ritme_salamat
DB_USERNAME=ritme
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_OTP_TEST_MODE=true

# SMS providers (leave empty in OTP test mode)
SMS_PROVIDER=smsir
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=511293
SMSIR_LINE_NUMBER=
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
