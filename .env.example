# Docker Compose environment for the Ritme stack. Copy to .env and fill in.
APP_KEY=base64:GENERATE_WITH_openssl_rand_-base64_32
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_DATABASE=ritme_salamat
DB_USERNAME=ritme
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# SMS providers — required: there is no test/bypass mode, every login sends a
# real SMS.
SMS_PROVIDER=kavenegar
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=511293
SMSIR_LINE_NUMBER=
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
# Kavenegar lookup (verify) template name for the login OTP
KAVENEGAR_TEMPLATE_LOGIN_OTP=1507703
