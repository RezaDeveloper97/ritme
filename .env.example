# Docker Compose environment for the Ritme stack. Copy to .env and fill in.
# APP_KEY: generate your own, never commit one (T-M12-07). Either
#   cd backend && php artisan key:generate --show
# or: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_DATABASE=ritme_salamat
DB_USERNAME=ritme
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Public origin of the web site (no path, no trailing slash), e.g. https://example.com. Server-only, read at runtime by
# the frontend for metadataBase and canonical / OpenGraph URLs on the public (web) pages. Leave empty in local dev
# (the request host is used there); set it on every deployed environment.
SITE_URL=

# SMS providers — required: there is no test/bypass mode, every login sends a
# real SMS.
SMS_PROVIDER=kavenegar
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=511293
SMSIR_LINE_NUMBER=
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
# Kavenegar lookup (verify) template name for the login OTP
KAVENEGAR_TEMPLATE_LOGIN_OTP=1507703

# Web Push for medication reminders (backend-go internal/care). Generate once per environment on the server:
#   docker compose exec backend-go /app/api vapid-keys
# The private key is a secret. Changing the pair invalidates every stored browser subscription. Empty = web push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@ritme.app

# «یادآور پیامکی» for Ritme Plus (medication doses + doctor appointments by SMS). none | fake | gateway.
# gateway needs three Kavenegar verify/lookup templates (names below):
#   med-reminder:          «ریتمی: وقت %token10 است (ساعت %token).»
#   appointment-reminder:  «ریتمی: یادآور %token10، %token20.»
#   neutral (required for users with «متن خنثی» on, the default): «ریتمی: برای ساعت %token یک یادآور داری.»
REMINDER_SMS_PROVIDER=none
KAVENEGAR_TEMPLATE_MED_REMINDER=med-reminder
KAVENEGAR_TEMPLATE_APPOINTMENT_REMINDER=appointment-reminder
KAVENEGAR_TEMPLATE_REMINDER_NEUTRAL=
REMINDER_SMS_DAILY_CAP=8
