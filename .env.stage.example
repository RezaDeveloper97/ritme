# Compose environment for the Ritme STAGING stack (stage.ritmeapp.ir).
# Lives at /opt/ritme-stage/.env on the server. Server-only: deploy-stage.sh
# excludes it from rsync, so editing it here changes nothing — edit it there.
#
# Generate a fresh APP_KEY (do NOT reuse production's):
#   echo "APP_KEY=base64:$(openssl rand -base64 32)"

APP_KEY=base64:GENERATE_WITH_openssl_rand_-base64_32
# APP_ENV is forced to `staging` by docker-compose.stage.yml; only APP_DEBUG is
# yours to flip. Staging is internet-facing (behind Basic auth), so leave it
# false unless you are actively chasing a 500.
APP_DEBUG=false
APP_URL=https://stage.ritmeapp.ir

# Own database, own credentials. Never point staging at the production DB —
# the containers are isolated, but the passwords should be too.
DB_DATABASE=ritme_stage
DB_USERNAME=ritme_stage
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Staging serves the API from the SAME origin as the frontend (production
# splits them across api./web. subdomains, but only stage.ritmeapp.ir has a DNS
# record here). Same origin means no CORS entry is needed in
# backend/config/cors.php. Baked into the browser bundle at build time.
NEXT_PUBLIC_API_BASE_URL=https://stage.ritmeapp.ir/api/v1

# Admin panel seed. Distinct from production's — a staging password leak must
# not be a production password leak.
ADMIN_SEED_EMAIL=admin@ritmeapp.ir
ADMIN_SEED_PASSWORD=change-me

# SMS — every login sends a real SMS and costs real credit. Reuse the
# production provider keys if you want to log in with a real phone number.
SMS_PROVIDER=kavenegar
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=511293
SMSIR_LINE_NUMBER=
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_TEMPLATE_LOGIN_OTP=1507703

# Swagger UI at /docs has its own Basic-auth gate on top of the vhost's.
SWAGGER_USER=ritme
SWAGGER_PASSWORD=

# Ritme Plus (B-N2-04). Money is integer rials; VAT in basis points (1000 = 10 %).
PLUS_VAT_RATE_BPS=1000
PLUS_TRIAL_DAYS=7
PLUS_INVOICE_TTL_MINUTES=30
# The web app's payment return page (also the first entry of the return allow-list).
PLUS_CALLBACK_URL=https://stage.ritmeapp.ir/plus/return

# Payment gateway adapter (B-N2-05, backend-go/internal/payments).
# PAYMENT_PROVIDER: fake (TEST page served by the API, no money moves; default outside production and refused when
# APP_ENV=production) | zarinpal | none (checkout answers 503). Café Bazaar / Myket billing is Android-only → not here.
PAYMENT_PROVIDER=fake
# Public origin of the API (the gateway returns the browser to <this>/api/v1/payments/<provider>/return). Defaults to APP_URL.
PAYMENT_CALLBACK_BASE_URL=https://stage.ritmeapp.ir
# Extra allow-listed return pages (comma separated, scheme+host+path); PLUS_CALLBACK_URL is always allowed.
PAYMENT_RETURN_URLS=
PAYMENT_HTTP_TIMEOUT_SECONDS=15
# Zarinpal v4 — only with PAYMENT_PROVIDER=zarinpal. The merchant id is a secret: set it on the server only, never
# commit it. Empty = payments disabled (503). ZARINPAL_SANDBOX=true uses sandbox.zarinpal.com.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# AI adapter (B-N3-05 voice logging; extended by B-N6-05), backend-go/internal/ai.
# AI_PROVIDER: fake (deterministic fixtures, no network; default outside production and refused when
# APP_ENV=production) | gemini (Google Gemini REST) | none (AI features answer 503 ai_unavailable).
AI_PROVIDER=fake
AI_HTTP_TIMEOUT_SECONDS=30
# Gemini — only with AI_PROVIDER=gemini. The key is a secret: set it on the server only, never commit it and never
# put it in a log. Empty = AI disabled (503). GEMINI_BASE_URL overrides the API origin (tests only).
# Use ONLY a paid-tier Gemini API key or Vertex AI (no use of prompts/audio for model training, with a DPA) —
# the free tier may use inputs for training, which is not acceptable for health data.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Companion «همدم» invites (B-N4-02, backend-go/internal/companion + internal/sms).
# COMPANION_SMS_PROVIDER: fake (logs a masked number, sends nothing; default outside production and refused when
# APP_ENV=production) | gateway (Kavenegar verify/lookup with KAVENEGAR_TEMPLATE_COMPANION_INVITE, token = the code) |
# none (no SMS; the owner shares the code herself).
COMPANION_SMS_PROVIDER=fake
KAVENEGAR_TEMPLATE_COMPANION_INVITE=companion-invite
# HMAC pepper of invite codes at rest — a secret: generate on the server (openssl rand -base64 48), never commit it.
# Required in production (≥ 32 bytes; empty there = invites answer 503). Changing it invalidates open (≤ 24 h) invites.
COMPANION_CODE_PEPPER=
