# Admin API base the browser calls. Same-origin in production (nginx on the admin
# host proxies /api/admin/ to backend-go), so a path is enough.
NEXT_PUBLIC_ADMIN_API_BASE_URL=/api/admin/v1
# Public API base, used only for GET /languages (the content-language registry).
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Optional URL prefix the admin is served under (Next basePath), build time.
# Empty in production (own host); staging uses /panel on the shared origin.
NEXT_PUBLIC_ADMIN_BASE_PATH=
# Dev only: where `next dev` proxies /api/* so the browser stays same-origin and
# the session cookie works without CORS. Run backend-go with APP_ENV=local and
# ADMIN_COOKIE_SECURE=false (plain http). Unset in production builds.
ADMIN_API_PROXY_TARGET=http://localhost:8020
