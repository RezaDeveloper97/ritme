<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Pre-Compose window theme. Compose draws the real UI via RitmeTheme; this only
         controls the window/splash background before the first frame. The app is light-only
         (mirroring the web — see RitmeTheme), so the window background is a night-invariant
         light color and there is no values-night override. No AppCompat/Material Components
         dependency — CLAUDE.md §3/§5c. -->
    <style name="Theme.Ritme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ritme_window_bg</item>
    </style>
</resources>