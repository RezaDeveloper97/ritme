<?xml version="1.0" encoding="utf-8"?>
<!--
  The Ritme backend is HTTPS-only (Let's Encrypt cert on the nginx proxy; http 301-redirects),
  so ritmeapp.ir needs no cleartext exemption. The bare IP is kept as a cleartext escape hatch
  because the certificate covers the domain names only — a request to 62.60.198.240 cannot
  validate. Prefer the domain everywhere; nothing in the app should use the IP by default.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">62.60.198.240</domain>
    </domain-config>
</network-security-config>
