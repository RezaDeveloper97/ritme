# backend-go — example environment (copy to .env and adjust).
# The full variable list is in README.md → Configuration; the names are the Laravel backend's,
# so both stacks can share one .env. Required variables are marked (required).

# --- Database (MariaDB) ---
DB_HOST=127.0.0.1            # (required)
DB_PORT=3306
DB_DATABASE=ritme            # (required)
DB_USERNAME=ritme            # (required)
DB_PASSWORD=

# --- Database pool (T-M9-09) — one database/sql pool shared by every request ---
# Invalid values stop the server at startup with the list of bad variables.
# Max open connections (>= 1).
DB_MAX_OPEN=25
# Max idle connections (1..DB_MAX_OPEN). Unset = DB_MAX_OPEN, so a burst does not close and reopen connections.
DB_MAX_IDLE=25
# Max age of a connection before it is replaced. A Go duration (5m, 90s) or whole seconds (300).
DB_CONN_MAX_LIFETIME=5m
# Max time a connection may stay idle before it is closed. A Go duration or whole seconds.
DB_CONN_MAX_IDLE_TIME=2m
