# Dependencies are installed inside the image.
vendor/
node_modules/

# Local env & secrets — config comes from container env vars.
.env
.env.backup
.env.production

# Passport signing keys. They live only on the `backend-storage` named volume,
# which is mounted over storage/ at runtime. Baking them into the image once
# shipped the developer laptop's pair to prod; never again.
storage/*.key

# VCS / IDE / tooling
.git
.idea/
.vscode/
.phpunit.cache/
.phpunit.result.cache

# Noise
*.log
.DS_Store
