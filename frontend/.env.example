# Copy to `.env.local` and fill in. Never commit real secrets.
# See src/shared/config/env.ts for how these are validated.

# Base URL of the Ritme API (public; embedded in the client bundle).
# The live backend is served over plain http and lives under /api/v1.
NEXT_PUBLIC_API_BASE_URL=https://ritmeapp.ir/api/v1

# OTP test mode: send-otp asks the backend to skip real SMS and accept "1111"
# as the code. Defaults to ON while we are not in production; set to "false"
# in production to send real OTPs.
NEXT_PUBLIC_OTP_TEST_MODE=true
