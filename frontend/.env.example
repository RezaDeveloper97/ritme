# Copy to `.env.local` and fill in. Never commit real secrets.
# See src/shared/config/env.ts for how these are validated.

# Base URL of the Ritme API (public; embedded in the client bundle).
# The live backend is served over plain http and lives under /api/v1.
NEXT_PUBLIC_API_BASE_URL=https://ritmeapp.ir/api/v1


# Dev-only: split /api/v1 between backend-go (care) and a legacy origin via Next rewrites (see next.config.ts)
# DEV_CARE_API_ORIGIN=http://127.0.0.1:8020
# DEV_LEGACY_API_ORIGIN=http://127.0.0.1:8010
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
