# -----------------------------------------------------------------------------
# Ritme site — production .env for cPanel shared hosting (L10-01)
# Copy to .env (php artisan app:install does it when .env is missing), fill the
# <…> values, keep the file at mode 600. Never commit or upload a filled copy.
# Guide: docs/DEPLOY-CPANEL.md · checklist: docs/SECURITY.md §5
# -----------------------------------------------------------------------------

APP_NAME=Ritme
APP_ENV=production
# Generated by `php artisan app:install` (key:generate) when empty. Never change it after go-live.
APP_KEY=
# Must stay false in production (app:install / app:upgrade refuse otherwise).
APP_DEBUG=false
# The canonical origin, https once AutoSSL issued the certificate.
APP_URL=https://<your-domain>
# true → http and the non-canonical host (www / non-www) answer one 301 to APP_URL. HSTS is sent automatically.
APP_CANONICAL_REDIRECT=true

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR
APP_TIMEZONE=Asia/Tehran

# Maintenance mode (app:upgrade) is a file in storage/framework — works without Redis.
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL / MariaDB created in cPanel → MySQL Databases. Database and user names carry the account prefix.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<cpaneluser>_ritme
DB_USERNAME=<cpaneluser>_ritme
DB_PASSWORD=<strong-password>

# Sessions: files in storage/framework/sessions. Secure cookie is automatic for an https APP_URL.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# The database queue is drained by the cron scheduler (queue:work --stop-when-empty every minute).
QUEUE_CONNECTION=database

# file works on every host; `database` when the account's inode quota is tight. Redis only if the host offers it.
CACHE_STORE=file
CACHE_PREFIX=ritme_site_

# Media library: written straight into <public>/media (no storage:link / symlink). Leave empty for the default;
# set an absolute path only when the public folder is somewhere unusual.
# MEDIA_PUBLIC_ROOT=/home/<cpaneluser>/public_html/media
# MEDIA_PUBLIC_URL=/media

# Guest full-page cache + HTTP caching + security headers (config/pagecache.php)
PAGE_CACHE_ENABLED=true
# HTTP_CACHE_S_MAXAGE=300
# SECURITY_HSTS=
# SECURITY_HSTS_SUBDOMAINS=false

# Mail: the host's SMTP (cPanel → Email Accounts → Connect Devices). Port 465 = smtps, 587 = STARTTLS.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.<your-domain>
MAIL_PORT=465
MAIL_USERNAME=no-reply@<your-domain>
MAIL_PASSWORD=<mailbox-password>
MAIL_FROM_ADDRESS="no-reply@<your-domain>"
MAIL_FROM_NAME="ریتمی"

VITE_APP_NAME="${APP_NAME}"

# Proxies whose X-Forwarded-* headers are trusted. Empty on plain cPanel; the CDN/proxy ranges only if one sits in front.
TRUSTED_PROXIES=

# Admin panel: every role that reads personal data must enrol TOTP.
ADMIN_PATH=admin
ADMIN_SESSION_TIMEOUT=60
ADMIN_MFA_ROLES=super-admin,shop-manager,directory-manager,support

# Operator alerts + backups (L10-02, docs/GO-LIVE.md). A mailbox someone reads: failed queued jobs (max one mail per
# job class per hour) and failed / too-old backups are mailed here. Empty = only logged.
OPS_ALERT_EMAIL=<ops-mailbox@your-domain>
# OPS_ALERT_THROTTLE_MINUTES=60
# Nightly DB + media backup into storage/app/private/<BACKUP_NAME>/ (private, never web-reachable).
BACKUP_NAME=ritme-site
BACKUP_DISKS=local
BACKUP_MAX_AGE_DAYS=1
# Keep below the hosting quota: the oldest backups are deleted above this size.
BACKUP_MAX_STORAGE_MB=4000
# Optional AES-256 password on the zip (store it next to APP_KEY in the password manager).
# BACKUP_ARCHIVE_PASSWORD=
