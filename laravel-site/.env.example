APP_NAME=Ritme
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# Production: true → 301 to the https scheme + host of APP_URL (CanonicalizeUrl).
APP_CANONICAL_REDIRECT=false

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_TIMEZONE=Asia/Tehran

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Dev + tests use SQLite. Production (cPanel) uses MySQL/MariaDB:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ritme_site
# DB_USERNAME=ritme_site
# DB_PASSWORD=
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# file works on every cPanel host; switch to redis when available
CACHE_STORE=file
# CACHE_PREFIX=

# Guest full-page cache + HTTP caching + security headers (config/pagecache.php, L1-07)
PAGE_CACHE_ENABLED=true
# PAGE_CACHE_TTL=            # seconds; empty = cacheaside `pages` namespace TTL
# PAGE_CACHE_MINIFY=true
# HTTP_CACHE_S_MAXAGE=300    # shared-cache lifetime of cookie-free guest pages (0 = never public)
# HTTP_CACHE_SWR=60
# SECURITY_HEADERS=true
# SECURITY_HSTS=             # empty = on in production (https only)
# SECURITY_HSTS_SUBDOMAINS=false

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Security (L9-04): proxies whose X-Forwarded-* headers are trusted (comma list or *), empty = none.
TRUSTED_PROXIES=
# Admin roles that must enrol TOTP (default: every role that reads personal data, L9-04b).
ADMIN_MFA_ROLES=super-admin,shop-manager,directory-manager,support
