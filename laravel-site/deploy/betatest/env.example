# Ritme site — betatest .env (server-only: /opt/ritme-site/.env, mode 600, never rsynced).
# deploy-betatest.sh creates it from this template on the first deploy, filling the secrets marked <generated>.

APP_NAME=Ritme
# staging, not production: robots.txt answers `Disallow: /` and every page is noindex — a beta must never be indexed.
APP_ENV=staging
APP_KEY=<generated>
APP_DEBUG=false
APP_URL=https://betatest.ritme.app
# ArvanCloud already redirects http → https at the edge; an app-level redirect behind it could loop.
APP_CANONICAL_REDIRECT=false

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR
APP_TIMEZONE=Asia/Tehran
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ritme_site
DB_USERNAME=ritme_site
DB_PASSWORD=<generated>
DB_ROOT_PASSWORD=<generated>

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=file
CACHE_PREFIX=ritme_site_
FILESYSTEM_DISK=local
PAGE_CACHE_ENABLED=true

# No real mailbox yet: mails (newsletter confirm, contact/order notifications) go to the log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@ritme.app"
MAIL_FROM_NAME="ریتمی"

# The app container is reachable only through the production nginx proxy on the private docker network.
TRUSTED_PROXIES=*

ADMIN_PATH=admin
ADMIN_SESSION_TIMEOUT=60
ADMIN_MFA_ROLES=super-admin,shop-manager,directory-manager,support

OPS_ALERT_EMAIL=
BACKUP_NAME=ritme-site
BACKUP_DISKS=local
BACKUP_MAX_STORAGE_MB=1500

# Demo blog/directory/shop rows for the beta (deploy-betatest.sh runs the demo seeders when 1).
SEED_DEMO=1
