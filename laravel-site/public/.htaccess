# -----------------------------------------------------------------------------
# Ritme — Apache / LiteSpeed rules for cPanel (L1-07)
#
# Works with this folder deployed as public_html (or any document root): no
# absolute paths, no rewrite base, every module guarded by <IfModule>, so a host
# without a module simply skips that block instead of answering 500.
# HTML caching, ETag/304, CSP and HSTS are sent by Laravel (config/pagecache.php);
# this file only covers static files, compression and URL plumbing.
# Apache does not allow comments at the end of a directive line, so every
# directive is explained on the comment line(s) right above it.
# -----------------------------------------------------------------------------

# --- Front controller (L10-01) -------------------------------------------------
<IfModule mod_dir.c>
    # "/" is Laravel even when the host left its placeholder index.html in public_html.
    DirectoryIndex index.php
</IfModule>

# --- Folder listings (L9-04) ---------------------------------------------------
<IfModule mod_autoindex.c>
    # Never list a folder's files (e.g. /media/2026/10/), even where mod_negotiation is absent.
    Options -Indexes
</IfModule>

# --- Rewriting ---------------------------------------------------------------
<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        # No content negotiation (/about must not match about.php) and no folder listings.
        Options -MultiViews -Indexes
    </IfModule>

    # Turn the rewrite engine on for this directory.
    RewriteEngine On

    # Force https — uncomment on hosts where Laravel's APP_CANONICAL_REDIRECT is not used.
    # Skip when TLS is already on, or when a proxy/CDN terminated TLS and says so.
    # RewriteCond %{HTTPS} !=on
    # RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    # 301 to the same host and path over https.
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Refuse dotfiles and dot-folders (.env, .git/…) except /.well-known (ACME / AutoSSL).
    RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]

    # Fallback layout (L10-01, deploy/cpanel/root.htaccess): with the whole package in public_html, this folder is
    # also reachable as /public/… — a duplicate of every URL. Requests that literally ask for /public/… answer 404
    # (the root .htaccess's internal rewrite keeps the original request line, so it is not affected).
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s/public(/|\s|\?)
    RewriteRule ^ - [R=404,L]

    # Security (L9-04): if the whole project was ever unpacked into the document root by mistake, never serve the
    # application itself — config, code, logs, sessions, dependencies, the SQLite file and dev tooling all answer 403.
    # (The supported layout keeps everything but this folder outside public_html — docs/SECURITY.md.) Only paths that
    # really exist on disk are refused, so public routes such as /tools are never affected.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^(app|bootstrap|config|database|lang|node_modules|resources|routes|storage|tests|tools|vendor|design|docs|tasks)(/|$) - [F,L]
    # Same for root-level project files (composer.*, package*.json, artisan, phpunit.xml, *.md, *.lock, *.sqlite …).
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|phpstan\.neon(\.dist)?|pint\.json|vite\.config\.js|[^/]+\.(md|lock|sqlite|sqlite3|db|log|sql|bak|swp|dist|ini|sh))$ - [F,L,NC]

    # Security (L9-04): no PHP is ever executed from this folder except the front controller. Uploads land in /media
    # with an extension chosen from the sniffed type, but a stray *.php (or .phtml/.phar …) anywhere answers 403.
    # The path is relative to this folder, so the internal pass after the front-controller rewrite ("index.php") and
    # a direct /index.php request still work.
    RewriteRule ^(?!index\.php$).*\.(php[0-9]?|phtml|phar|pht|phps|shtml|cgi|pl|py|asp|aspx|jsp)$ - [F,L,NC]

    # Hashed Vite build files and generated media variants get the immutable cache header below.
    RewriteRule ^(build|media)/ - [E=RT_IMMUTABLE:1]

    # Uploaded SVGs (sanitised on upload) get a sandboxing CSP below (L9-04).
    RewriteRule ^media/.+\.svgz?$ - [E=RT_MEDIA_SVG:1,NC]

    # Pass the Authorization header through to PHP (CGI/FastCGI drop it otherwise) …
    RewriteCond %{HTTP:Authorization} .
    # … by copying it into an environment variable Laravel reads.
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Same for the X-XSRF-Token header …
    RewriteCond %{HTTP:x-xsrf-token} .
    # … used by JavaScript requests (Livewire / admin).
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # No Apache trailing-slash redirect here: App\Http\Middleware\CanonicalizeUrl does
    # slashes, *.html, case and legacy URLs in one single 301 hop.

    # Anything that is not an existing folder …
    RewriteCond %{REQUEST_FILENAME} !-d
    # … nor an existing file …
    RewriteCond %{REQUEST_FILENAME} !-f
    # … goes to Laravel's front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# --- Deny dotfiles (second line of defence when mod_rewrite is missing) -------
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        # Apache 2.4 / LiteSpeed syntax.
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        # Apache 2.2 syntax: evaluate allow before deny …
        Order allow,deny
        # … and deny everyone.
        Deny from all
    </IfModule>
</FilesMatch>

# --- MIME types (some cPanel servers ship an old mime.types) ------------------
<IfModule mod_mime.c>
    # Web fonts.
    AddType font/woff2 .woff2
    # Next-gen images produced by the media pipeline.
    AddType image/avif .avif
    # WebP variants.
    AddType image/webp .webp
    # SVG sprite and illustrations.
    AddType image/svg+xml .svg
    # PWA manifest.
    AddType application/manifest+json .webmanifest
    # ES modules (Vite chunks, service worker).
    AddType text/javascript .js .mjs
    # Declare UTF-8 for text assets so Persian text never renders as mojibake.
    AddCharset utf-8 .css .js .mjs .json .svg .webmanifest .txt .xml
</IfModule>

# --- Compression: brotli when the module exists, gzip otherwise --------------
<IfModule mod_filter.c>
    <IfModule mod_brotli.c>
        # Brotli for clients that accept br; DEFLATE in the chain serves gzip to the rest.
        AddOutputFilterByType BROTLI_COMPRESS;DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/ld+json application/xml application/rss+xml application/atom+xml application/manifest+json image/svg+xml font/ttf font/otf
    </IfModule>
    <IfModule !mod_brotli.c>
        <IfModule mod_deflate.c>
            # gzip the same text types (woff2, avif, webp, jpg, png are already compressed).
            AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/ld+json application/xml application/rss+xml application/atom+xml application/manifest+json image/svg+xml font/ttf font/otf
        </IfModule>
    </IfModule>
</IfModule>

# --- Browser caching of static files -----------------------------------------
<IfModule mod_expires.c>
    # Send Expires / max-age for the types listed below.
    ExpiresActive On
    # Fonts never change under the same URL (they live in /build with a hash).
    ExpiresByType font/woff2 "access plus 1 year"
    # Images: build assets and media variants are hashed / immutable.
    ExpiresByType image/avif "access plus 1 year"
    # WebP.
    ExpiresByType image/webp "access plus 1 year"
    # JPEG.
    ExpiresByType image/jpeg "access plus 1 year"
    # PNG.
    ExpiresByType image/png "access plus 1 year"
    # GIF.
    ExpiresByType image/gif "access plus 1 year"
    # SVG.
    ExpiresByType image/svg+xml "access plus 1 year"
    # Favicon.
    ExpiresByType image/x-icon "access plus 1 week"
    # CSS: Vite files are hashed, Filament files carry ?v=.
    ExpiresByType text/css "access plus 1 year"
    # JavaScript: same as CSS (sw.js is overridden below).
    ExpiresByType text/javascript "access plus 1 year"
    # JavaScript (older MIME name).
    ExpiresByType application/javascript "access plus 1 year"
    # The PWA manifest may change with a release: one hour.
    ExpiresByType application/manifest+json "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
    # /build/* and /media/* (flag set by the rewrite rule above): cache for a year, never revalidate.
    Header set Cache-Control "public, max-age=31536000, immutable" env=RT_IMMUTABLE

    # Self-hosted fonts outside /build (Filament) are immutable too.
    <FilesMatch "\.(woff2?|ttf|otf)$">
        # One year, no revalidation.
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # The service worker must be re-checked on every navigation so updates ship at once.
    <Files "sw.js">
        # Browsers may store it but must revalidate first.
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </Files>

    # The manifest is fetched rarely; keep it short so icon/name changes appear the same day.
    <Files "manifest.webmanifest">
        # One hour.
        Header set Cache-Control "public, max-age=3600"
    </Files>

    # Compressible files: tell caches the body depends on Accept-Encoding (merge = no duplicates).
    <FilesMatch "\.(html|css|js|mjs|json|svg|xml|txt|webmanifest)$">
        # Vary on the compression the client accepts.
        Header merge Vary Accept-Encoding
    </FilesMatch>

    # Security (L9-04): static files never pass through Laravel's SecurityHeaders, so the browser must not
    # second-guess their declared type (a GIF/JS polyglot in /media stays an image) …
    Header always set X-Content-Type-Options "nosniff"
    # … and an uploaded SVG (/media, flag set by the rewrite rule above) opened directly is a sandboxed document: no
    # scripts, no forms, no plugins, no same-origin access, even if the sanitiser ever missed something. Inline styles
    # are what SVG artwork uses. The icon sprite in /build is left alone (it is referenced by <use>).
    Header always set Content-Security-Policy "default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; sandbox" env=RT_MEDIA_SVG

    # Do not advertise the PHP version.
    Header always unset X-Powered-By
    # Some handlers add it after "always"; remove the normal copy too.
    Header unset X-Powered-By
</IfModule>
